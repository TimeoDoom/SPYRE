generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id
  mailAddress        String?
  mailAppPasswordEnc String?
  imapHost           String?
  imapPort           Int?
  imapSecure         Boolean?
  smtpHost           String?
  smtpPort           Int?
  smtpSecure         Boolean?
  uiTheme            String?
  uiTexture          String?
  uiLanguage         String?
  uiBackground       Json?
  spaceEmails        Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  spaces   Space[]
  contacts Contact[]
}

model Space {
  id              String   @id
  userId          String
  name            String
  color           String?
  icon            String?
  bgColor         String?
  columnBgColor   String?
  columnBackground Json?
  textColor       String?
  buttonBgColor   String?
  mailFont        String?
  mailFontSize    Int?
  railGradientFrom String?
  railGradientTo  String?
  appBackground   Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Contact {
  id                 String   @id @default(cuid())
  userId             String
  email              String
  favorite           Boolean  @default(false)
  avatarUrl          String?
  avatarContentType  String?
  avatarUpdatedAt    DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, email])
}

model EmailMetadata {
  id              String   @id // Format: "FOLDER:UID"
  uid             String
  folder          String   // "INBOX", "[Gmail]/Sent Mail", etc.
  threadId        String?
  messageId       String?
  inReplyTo       String?
  references      String   @default("[]") // JSON string[]
  from            String
  to              String
  cc              String   @default("")
  subject         String   @default("")
  date            DateTime
  snippet         String   @default("")
  seen            Boolean  @default(false)
  flagged         Boolean  @default(false)
  hasAttachments  Boolean  @default(false)
  bodyText        String   @default("")
  bodyHtml        String   @default("")
  attachments     String   @default("[]") // JSON
  rawSize         Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([folder, date(sort: Desc)])
  @@index([threadId])
}