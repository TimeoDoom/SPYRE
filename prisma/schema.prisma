generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(uuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Mail settings
  mailAddress        String?
  mailAppPasswordEnc String?
  imapHost           String?
  imapPort           Int?
  imapSecure         Boolean?
  smtpHost           String?
  smtpPort           Int?
  smtpSecure         Boolean?

  // UI settings
  uiTheme            String?
  uiTexture          String?
  uiBackground       Json?
  uiLanguage         String?

  // Stored as JSON: spaceId -> mailbox -> [emailIds]
  spaceEmails        Json?

  spaces             Space[]
  contacts           Contact[]
}

model Space {
  id              String   @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String
  color           String?
  icon            String?
  bgColor         String?
  columnBgColor   String?
  columnBackground Json?
  textColor       String?
  buttonBgColor   String?
  mailFont        String?
  mailFontSize    Int?
  railGradientFrom String?
  railGradientTo   String?
  appBackground   Json?

  createdAt       DateTime @default(now())

  @@id([userId, id])
  @@index([userId])
}

model Contact {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  email     String
  favorite  Boolean  @default(false)
  avatarUrl String?
  avatarData Bytes?
  avatarContentType String?
  avatarUpdatedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([userId, email])
  @@index([userId])
}
